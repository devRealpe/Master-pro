rules_version = '2';

// Master Pro es de una sola persona: todo su contenido cuelga de users/{uid}
// y solo esa persona, con sesión iniciada, puede leerlo o escribirlo.
// Cualquier otra ruta queda denegada por omisión.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
